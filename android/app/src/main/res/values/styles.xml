<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting.
         Koyu arka plan: açılışta beyaz ekran yanıp sönmesin. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         Bu tema Flutter UI'sinin arkasındaki pencere rengini belirler.
         Light yerine koyu → kanal listesi yüklenirken beyaz boşluk görünmez. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
    </style>
</resources>
